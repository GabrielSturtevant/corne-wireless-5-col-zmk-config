#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/mouse.h>

#define AS(keycode) &as LS(keycode) keycode
#define LEFT_HAND_KEYS 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32
#define RIGHT_HAND_KEYS 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35
#define BASE 0
#define MEDIA 1
#define NAV 2
#define MOUSE 3
#define SYM 4
#define NUM 5
#define FUN 6



/ {
    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    macros {
        m_tilde_forward_slash: m_tilde_forward_slash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <40>;
            bindings = <&kp TILDE &kp FSLH>;
        };
        m_dot_forward_slash: m_dot_forward_slash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <40>;
            bindings = <&kp DOT &kp FSLH>;
        };
    };

    behaviors {
        magic_key1: magic_key1 {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;

            /* Fallback behavior if no trigger matches */
            bindings = <&kp ESC>;

            /* Trigger 1: Pressing B -> Magic Key outputs "efore" (completes "before") */

            magic_t {
                trigger-keys = <T>;
                max-prior-idle-ms = <350>;
                bindings = <&kp M &kp E &kp N &kp T >;
            };
            magic_j {
                trigger-keys = <J>;
                max-prior-idle-ms = <350>;
                bindings = <&kp U &kp S &kp T >;
            };
            magic_b {
                trigger-keys = <B>;
                max-prior-idle-ms = <350>;
                bindings = <&kp E &kp C &kp A &kp U &kp S &kp E>;
            };
            magic_w {
                trigger-keys = <W>;
                max-prior-idle-ms = <350>;
                bindings = < &kp O &kp U &kp L &kp D >;
            }
            magic_space {
                trigger-keys = <SPACE>;
                max-prior-idle-ms = <350>;
                bindings = < &kp T &kp H &kp E >;
            }
            magic_i {
                trigger-keys = <I>;
                max-prior-idle-ms = <350>;
                bindings = < &kp N &kp G >;
            }

        };
        mf1: magic_function_layer_tap1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&magic_key1>;
        };
        magic_key2: magic_key2 {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;

            /* Fallback behavior if no trigger matches */
            bindings = <&kp DEL>;

            /* Trigger 1: Pressing B -> Magic Key outputs "efore" (completes "before") */

            magic_a {
                trigger-keys = <A>;
                max-prior-idle-ms = <350>;
                bindings = < &kp N &kp D >;
            };
            magic_comma {
                trigger-keys = <KP_COMMA>;
                max-prior-idle-ms = <350>;
                bindings = < &kp SPACE &kp B &kp U &kp T >;
            }
            magic_y {
                trigger-keys = <Y>;
                max-prior-idle-ms = <350>;
                bindings = < &kp O &kp U >;
            }

        };
        mf2: magic_function_layer_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&magic_key2>;
        };
        b_slash_hold_tap: b_slash_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&m_dot_forward_slash>, <&kp>;
        };
        open_shift_morph: open_shift_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LPAR>, <&kp LBRC>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        open_ctrl_morph: open_ctrl_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&open_shift_morph>, <&kp LBKT>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        open_morph: open_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&open_ctrl_morph>, <&kp LT>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        close_shift_morph: close_shift_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RPAR>, <&kp RBRC>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        close_ctrl_morph: close_ctrl_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&close_shift_morph>, <&kp RBKT>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        close_morph: close_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&close_ctrl_morph>, <&kp GT>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <175>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap";
        };
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap";
        };
        rmt: right_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <400>;
            quick_tap_ms = <200>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <LEFT_HAND_KEYS>;
            hold-trigger-on-release;
        };
        lmt: left_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <400>;
            quick_tap_ms = <200>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <RIGHT_HAND_KEYS>;
            hold-trigger-on-release;
        };
    };

    #include "combos.dtsi"

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  '  |  ,  |  .  |  P  |  Y  |     |  F  |  G   |  C   |  R   | L |
// |  A  |  O  |  E  |  U  |  I  |     |  D  |  H   |  T   |  N   | S | 
// |  ;  |  Q  |  J  |  K  |  X  |     |  B  |  M   |  W   |  V   | Z |
//             | GUI | LWR | SPC |     | ENT | RSE  | BSPC |
                        display-name = "Base";
                        bindings = <
   &mt EXCL SINGLE_QUOTE &mt AMPS COMMA &mt QMARK PERIOD &kp P &kp Y     &kp F   &kp G  &kp C  &kp R  &kp L
   &lmt LGUI A &lmt LALT O &lmt LCTRL E &lmt LSHIFT U &kp I             &kp D   &rmt RSHIFT H  &rmt RCTRL T &rmt RALT N  &rmt RGUI S
   &kp SEMICOLON &kp Q &kp J &kp K &kp X         &kp B   &kp M  &kp W  &kp V  &kp Z
        &mf1 MEDIA 0 &lt NAV SPACE &lt MOUSE TAB      &lt SYM ENTER &lt NUM BSPC &mf2 FUN 0 /* see magic_function_layer_tap behavior */
                        >;
                };

                media_layer {
                        display-name = "Media";
                        bindings = <
   &none    &none    &none     &to BASE  &none    &none    &none        &none        &none        &none
   &kp LGUI &kp LALT &kp LCTRL &kp LSHIFT &none    &none    &none        &none        &none        &none
   &none    &none    &tog FUN  &tog MEDIA &none    &none    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3
                     &none     &none      &none    &none    &none        &none
                        >;
                };

                nav_layer {
                        display-name = "Navigation";
                        bindings = <
   &none    &none    &none     &to BASE  &none    &kp K_REDO &kp K_PASTE &kp K_COPY &kp K_CUT &kp K_UNDO
   &kp LGUI &kp LALT &kp LCTRL &kp LSHIFT &none    &caps_word &kp LEFT    &kp DOWN   &kp UP    &kp RIGHT
   &none    &none    &tog NUM  &tog NAV  &none    &kp INS    &kp HOME    &kp PG_DN  &kp PG_UP &kp END
                     &none     &none      &none    &kp ENTER  &kp BSPC    &kp DEL
                        >;
                };
                mouse_layer {
                        display-name = "Mouse";
                        bindings = <
   &none    &none    &none     &to BASE   &none    &kp K_REDO &kp K_PASTE    &kp K_COPY     &kp K_CUT    &kp K_UNDO
   &kp LGUI &kp LALT &kp LCTRL &kp LSHIFT  &none    &none      &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT
   &none    &none    &tog SYM   &tog MOUSE &none    &none      &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT
                     &none     &none       &none    &mkp RCLK  &mkp LCLK      &mkp MCLK
                        >;
                };

                symbol_layer {
                        display-name = "Symbols";
                        bindings = <
   &kp LBRC  &kp AMPS &kp STAR     &kp RPAR      &kp RBRC   &none &to BASE  &none     &none    &none
   &kp QMARK &kp DLLR &kp PRCNT    &kp CARET     &kp PLUS   &none &kp RSHIFT &kp RCTRL &kp LALT &kp LGUI
   &kp TILDE &kp EXCL &kp AT       &kp POUND     &kp PIPE   &none &tog SYM   &tog MOUSE &none    &none
                      &open_morph  &close_morph  &kp UNDER  &none &none      &none
                        >;
                };

               number_layer {
                        display-name = "Numbers";
                        bindings = <
   &kp LBKT  &kp N7 &kp N8 &kp N9 &kp RBKT  &none &to BASE  &none     &none    &none
   &kp FSLH  &kp N4 &kp N5 &kp N6 &kp EQUAL &none &kp RSHIFT &kp RCTRL &kp LALT &kp LGUI
   &kp GRAVE &kp N1 &kp N2 &kp N3 &kp BSLH  &none &tog NUM   &tog NAV  &none    &none
                       &kp DOT   &kp N0 &kp MINUS &none &none      &none
                        >;
                };

                function_layer {
                        display-name = "Function";
                        bindings = <
   &kp F12 &kp F7 &kp F8    &kp F9    &kp PSCRN         &none &to BASE  &none      &none    &none
   &kp F11 &kp F4 &kp F5    &kp F6    &kp SLCK          &none &kp RSHIFT &kp RCTRL  &kp LALT &kp LGUI
   &kp F10 &kp F1 &kp F2    &kp F3    &kp PAUSE_BREAK   &none &tog FUN   &tog MEDIA &none    &none
                  &kp K_APP &kp SPACE &kp TAB           &none &none      &none
                        >;
                };

                mod_layer_2 {
                        display-name = "Mod2";
                        bindings = <
   &none    &none    &none    &none    &none    &none    &none    &none    &none    &none
   &none    &none    &none    &none    &none    &none    &none    &none    &none    &none
   &none    &none    &none    &none    &none    &none    &none    &none    &none    &none
                     &none    &none    &none    &none    &none    &none
                        >;
                };

                extra_1 {
                        status = "reserved";
                };

                extra_2 {
                        status = "reserved";
                };

                extra_3 {
                        status = "reserved";
                };
        };
};
